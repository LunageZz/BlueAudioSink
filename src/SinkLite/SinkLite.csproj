<Project Sdk="Microsoft.NET.Sdk">
  <!--
    重要：必须保持 OutputType=Exe。改成 WinExe 会让 SDK 静默引入
    Microsoft.WindowsDesktop.App（实测 10 MB -> 44 MB）。
    需要隐藏控制台窗口时用 app.manifest 或 editbin，不要改这里。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Per-Monitor V2 DPI 感知，避免高分屏上 UI 被系统拉伸而发糊 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SinkLite</RootNamespace>
    <AssemblyName>BlueAudioSink</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 必需：NAudio 与 IPolicyConfig 依赖内建 COM 互操作；
         开启裁剪后默认被禁用，运行时会抛 NotSupportedException。 -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <DebugType>none</DebugType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.3.3</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 只引用 Wasapi 子包：NAudio 主包会连带 NAudio.WinForms，
         进而把 Microsoft.WindowsDesktop.App（WPF）拖进发布产物，实测体积 10 MB -> 44 MB。 -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <!--
    托盘状态图标以资源形式内嵌。
    刻意不使用 System.Drawing/Bitmap：System.Drawing.Common 会把
    Microsoft.WindowsDesktop.App（WPF）拖进发布产物，实测体积 10 MB -> 44 MB。
  -->
  <ItemGroup>
    <!-- Carry the upstream MIT notice alongside the published executable. -->
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Include notices in both the standalone executable and the portable distribution. -->
    <EmbeddedResource Include="../../LICENSE" LogicalName="BlueAudioSink.LICENSE" />
    <EmbeddedResource Include="../../THIRD_PARTY_NOTICES.md" LogicalName="BlueAudioSink.THIRD_PARTY_NOTICES" />
    <EmbeddedResource Include="../../licenses/*.txt" />
    <None Include="../../licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <!-- 只保留一个图标：用作窗口与任务栏图标。
         托盘已移除，其余状态色图标不再需要。 -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>
  <!--
    发布后把子系统改为 WINDOWS，使双击启动不出现控制台窗口。
    刻意不改 OutputType：WinExe 会让 SDK 引入 Microsoft.WindowsDesktop.App（+34 MB）。
    有 MSVC 时使用 editbin；缺失时用仓库脚本修改同一 PE 字段，避免发布包弹出控制台。
  -->
  <PropertyGroup>
    <EditBinPath Condition="'$(EditBinPath)' == ''">E:\Microsoft Visual Studio\2022\Community\VC\Tools\MSVC\14.44.35207\bin\Hostx64\x64\editbin.exe</EditBinPath>
  </PropertyGroup>
  <Target Name="SetWindowsSubsystemForTray" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="&quot;$(EditBinPath)&quot; /SUBSYSTEM:WINDOWS &quot;$(PublishDir)BlueAudioSink.exe&quot;"
          ContinueOnError="true"
          Condition="Exists('$(EditBinPath)')" />
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\Set-WindowsSubsystem.ps1&quot; -Path &quot;$(PublishDir)BlueAudioSink.exe&quot;"
          Condition="'$(OS)' == 'Windows_NT' and !Exists('$(EditBinPath)')" />
  </Target>
</Project>
